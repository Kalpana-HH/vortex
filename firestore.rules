rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Universal Text Replacements collection
    match /text_replacements/{replacementId} {
      allow read: if true; // Publicly accessible so changes are universal across devices
      
      allow create, update: if request.auth != null && 
                     request.auth.token.email_verified == true && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com") &&
                     request.resource.data.updatedAt == request.time &&
                     request.resource.data.selector is string &&
                     request.resource.data.text is string;
                     
      allow delete: if request.auth != null && 
                     request.auth.token.email_verified == true && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com");
    }
  }
}
