rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Universal Text Replacements collection
    match /text_replacements/{replacementId} {
      allow read: if true; // Publicly accessible so changes are universal across devices
      
      allow create, update: if request.auth != null && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com") &&
                     request.resource.data.selector is string &&
                     request.resource.data.text is string;
                     
      allow delete: if request.auth != null && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com");
    }

    // Universal Image Replacements collection (drag-and-drop replacement)
    match /image_replacements/{replacementId} {
      allow read: if true; // Publicly accessible so images are synchronized universially
      
      allow create, update: if request.auth != null && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com") &&
                     request.resource.data.selector is string &&
                     request.resource.data.src is string;
                     
      allow delete: if request.auth != null && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com");
    }

    // Universal Link Replacements collection
    match /link_replacements/{replacementId} {
      allow read: if true; // Publicly accessible so hyperlinks are synchronized universally
      
      allow create, update: if request.auth != null && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com") &&
                     request.resource.data.selector is string &&
                     request.resource.data.href is string;
                     
      allow delete: if request.auth != null && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com");
    }

    // Universal Countdown Configuration collection
    match /countdown_config/{configId} {
      allow read: if true; // Publicly accessible so changes are universal across devices
      
      allow create, update: if request.auth != null && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com") &&
                     request.resource.data.eventTitle is string &&
                     request.resource.data.targetDateStr is string;
                     
      allow delete: if request.auth != null && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com");
    }

    // Universal Custom Lists collection (for gallery, sponsors, roster, etc.)
    match /custom_data/{documentId} {
      allow read: if true; // Publicly accessible so changes are universal across devices
      
      allow write: if request.auth != null && 
                     (request.auth.token.email == "anumulakalpana4u@gmail.com" || 
                      request.auth.token.email == "hraha0311@gmail.com");
    }
  }
}
